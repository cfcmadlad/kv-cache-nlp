# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Environments and credentials
.venv/
venv/
env/
.env
.env.*
*.pem
*.key

# Large or regenerable artefacts (fetch with scripts/fetch_assets.py and scripts/part3_assets.py)
checkpoints/
data/processed/
data/bytes/
runs/
*.zip
results/*
!results/part3/
!results/phase2.md

# Scheduler output
slurm/logs/*
!slurm/logs/.gitkeep

# LaTeX build products
report/*.aux
report/*.bbl
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.nav
report/*.out
report/*.snm
report/*.synctex.gz
report/*.toc
report/*.vrb

# PDFs are ignored except the three built documents and their figures
*.pdf
!report/main.pdf
!report/supplement.pdf
!report/slides.pdf
!report/figures/*.pdf

# Test, lint and coverage caches
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Logs and scratch files
*.log
*.tmp

# Editors, operating systems, agent scratch space
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
.claude/
node_modules/
report_kit/
private/
notes/
