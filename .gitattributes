# Store text with LF line endings in the repository; Git converts on checkout as needed.
* text=auto

*.py text
*.md text
*.txt text
*.json text
*.jsonl text
*.html text

# Windows batch files need CRLF line endings; shell scripts need LF.
*.bat text eol=crlf
*.sh text eol=lf

*.pt binary
*.pkl binary
*.zip binary
*.png binary
